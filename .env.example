# Screen Time Tracker — Vercel env
# Project → Settings → Environment Variables → add for Production + Preview, then Redeploy.

# --- Site ---
SITE_URL=https://screen-time-tracker-seven.vercel.app
INR_USD_RATE=95.12

# --- Payment mode (sandbox default is safest) ---
# Sandbox when: PAYMENT_TEST_MODE=true|1|yes  OR  MODE/PAYMENT_MODE/PAYPAL_MODE=sandbox|test
# Live when:    PAYMENT_TEST_MODE=false       OR  MODE=live  OR  ALLOW_LIVE_PAYMENTS=true (and not test)
# If PAYMENT_TEST_MODE unset but PAYPAL_TEST_* present → sandbox
PAYMENT_TEST_MODE=true
MODE=sandbox
ALLOW_LIVE_PAYMENTS=false
# Soft SIM preview when keys missing (capture/verify only unlocks Pro for SIM_* when true)
ALLOW_SIMULATED_CHECKOUT=true

# --- Supabase (STT project) ---
SUPABASE_URL=https://mproxhlssrniwlcywfhq.supabase.co
SUPABASE_ANON_KEY=paste_anon_key
SUPABASE_SERVICE_ROLE_KEY=paste_service_role_key

# --- Entitlement / mail / cron ---
ENTITLEMENT_SECRET=paste_openssl_rand_hex_32
MAIL_FROM=Screen Time Tracker <billing@fenwicklabs.com>
CRON_SECRET=paste_long_random_secret

# --- PayPal TEST (sandbox) ---
PAYPAL_TEST_CLIENT_ID=
PAYPAL_TEST_CLIENT_SECRET=
# Legacy fallbacks if TEST_/LIVE_ unset:
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# --- PayPal LIVE (only when PAYMENT_TEST_MODE=false) ---
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Razorpay TEST (sandbox) — MUST add KEY_SECRET if KEY_ID is set ---
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
# Legacy fallbacks:
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# --- Razorpay LIVE ---
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional Google (Auth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
